# Slack — user token version (replies post as YOU, not a bot)
# Get this after installing the app to your workspace, authorized as yourself:
# OAuth & Permissions -> "User OAuth Token" (starts with xoxp-)
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_SIGNING_SECRET=your-signing-secret

# Your own Slack member ID — used to make sure we never auto-reply to
# your own messages. Profile picture -> View profile -> ... -> Copy member ID
MY_SLACK_USER_ID=U0XXXXXXX

PORT=5001

# Freshdesk
FRESHDESK_DOMAIN=yourcompany
FRESHDESK_API_KEY=your-freshdesk-api-key
FRESHDESK_FEEDBACK_SCHEMA_ID=8797869

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Shared secret external systems must send when calling
# POST /webhook/notify  (header: X-Webhook-Secret)
WEBHOOK_SECRET=choose-a-long-random-string
