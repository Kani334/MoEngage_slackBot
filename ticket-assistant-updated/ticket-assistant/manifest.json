{
  "display_information": {
    "name": "Sibi Auto-Responder",
    "description": "Automatically answers ticket-related DMs sent to Sibisiddharth",
    "background_color": "#1a1a2e"
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "chat:write",
        "im:history",
        "im:read",
        "im:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_PUBLIC_URL/slack/events",
      "user_events": [
        "message.im"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
